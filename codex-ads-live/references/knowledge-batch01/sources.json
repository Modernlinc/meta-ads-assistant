        "publisher": "Meta for Developers",
        "url": "https://developers.facebook.com/documentation/ads-commerce/conversions-api/using-the-api",
        "title": "Using the API - Conversions API",
        "accessed_at": "2026-11-27",
        "published_at": null,
        "effective_at": null,
        "document_version": "页面未标全局版本；读取到的示例含v27.0，不据此推定客户使用版本",
        "section": [
          "Test Events Tool",
          "Upload Time versus Event Transaction Time"
        ],
        "status": "body_verified",
        "additional_refs": [
          "turn410273210view0"
        ],
        "locator": "L102-L105、L136-L142、L166",
        "supports": [
          "服务器事件可在Events Manager > Data Sources > 对应Pixel > Test Events中验证；测试ID作为test_event_code发送。",
          "test_event_code仅用于测试，正式payload需去掉该字段。",
          "该页明确指出带test_event_code的事件不会自动丢弃，会进入Events Manager并用于定向和广告测量，因此不能把它当作天然隔离的沙盒。",
          "event_time表示实际业务事件发生时间，而非上传时间。"
        ],
        "conditions": [
          "手工CAPI实施或具备合作伙伴提供的等价测试能力",
          "明确数据集、测试交易与测试授权"
        ],
        "limitations": [
          "未向任何真实账户发送事件。",
          "Shopify合作伙伴渠道未必允许用户直接编辑test_event_code；不能把手工API步骤机械套在渠道集成上。",
          "本轮未核验Diagnostics专属帮助页。"
        ],
        "skill_use": [
          "C04",
          "C20"
        ],
        "rule_candidate": "先检查集成类型和测试方式，测试事件发送属于独立授权动作；测试成功与生产链路完整仍分别验收。",
        "excerpt_id": "EX-OFF-20261127-04"
      }
    },
