    "OFF-20261127-01": {
      "creator_channel": "Meta for Developers",
      "title": "Handling Duplicate Pixel and Conversions API Events",
      "url": "https://developers.facebook.com/documentation/ads-commerce/conversions-api/deduplicate-pixel-and-server-events",
      "published_at": "",
      "review_status": "body_verified",
      "content_access": "OFFICIAL_PAGE",
      "source_kind": "official_document",
      "source_note_sha256": "7c75936628446682fe5fa3623c5a329260ce86cc08fba996ec752ea22dc1c41a",
      "official_record": {
        "id": "OFF-20261127-01",
        "publisher": "Meta for Developers",
        "url": "https://developers.facebook.com/documentation/ads-commerce/conversions-api/deduplicate-pixel-and-server-events",
        "title": "Handling Duplicate Pixel and Conversions API Events",
        "accessed_at": "2026-11-27",
        "published_at": null,
        "effective_at": null,
        "document_version": "未标全局版本的官方文档",
        "section": [
          "Event deduplication options > Event ID and event name (recommended)",
          "Setting up deduplication on the browser Pixel",
          "FBP or external ID > Approach limitations"
        ],
        "status": "body_verified",
        "locator": "L13-L24、L42-L46、L72-L75",
        "supports": [
          "对应的浏览器Pixel eventID须与CAPI event_id匹配；浏览器事件名须与服务器event_name匹配。",
          "文档规定同一Pixel ID下、相同事件名与事件ID的双路事件须在首个事件收到后的48小时窗口内，才能按本页说明去重。",
          "fbp/external_id替代方式有顺序与来源限制，不能把其行为泛化为所有同名事件都去重。"
        ],
        "conditions": [
          "同一次业务行为的浏览器与服务器事件",
          "核对同一Pixel/数据集以及事件名、ID、发送时间"
        ],
        "limitations": [
          "未核验任何客户的实际payload或平台去重回执。",
          "本页不能证明合作伙伴实现已经正确，也不能仅凭接收数高就判为重复。"
        ],
        "skill_use": [
          "C04",
          "C20"
        ],
        "rule_candidate": "收集双路payload及平台回执后再诊断去重；缺证据时输出待核，不能自动重装Pixel。",
        "excerpt_id": "EX-OFF-20261127-01"
      }
    },
