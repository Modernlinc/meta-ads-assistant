        "document_version": "未标全局版本的官方参数表",
        "section": [
          "Standard Parameters > currency",
          "Standard Parameters > value"
        ],
        "status": "body_verified",
        "locator": "L16、L73",
        "supports": [
          "Purchase事件要求currency；currency应是value对应的有效ISO 4217币种代码。",
          "Purchase事件及使用价值优化的事件要求value；value是表示货币金额的数值。"
        ],
        "conditions": [
          "Purchase或使用价值优化的事件",
          "value与currency成对核对"
        ],
        "limitations": [
          "参数有效不等于金额口径正确，仍须核对税、运费、折扣及退款。",
          "参数页本身没有给出该客户应采用何种利润或净收入定义。"
        ],
        "skill_use": [
          "C04",
          "C20",
          "C25"
        ],
        "rule_candidate": "检查类型、币种和金额口径；不可把不同币种的value直接相加。",
        "excerpt_id": "EX-OFF-20261127-02"
      }
    },
