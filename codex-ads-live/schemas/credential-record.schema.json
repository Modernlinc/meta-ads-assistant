{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-secret owner enrollment and local disable record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_id",
    "principal_id",
    "schema",
    "reference",
    "platform",
    "created_at",
    "state",
    "disabled_at"
  ],
  "properties": {
    "app_id": {
      "type": "string",
      "pattern": "^[0-9]{1,40}$"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[0-9]{1,40}$"
    },
    "schema": {
      "const": "credential-record-v1"
    },
    "reference": {
      "type": "string",
      "pattern": "^conn_[0-9a-f]{32}$"
    },
    "platform": {
      "enum": [
        "macos",
        "windows"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "PREPARED",
        "DISABLED_LOCAL"
      ]
    },
    "disabled_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "PREPARED"
          }
        }
      },
      "then": {
        "properties": {
          "disabled_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "disabled_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "$comment": "Runtime validates aware timestamps and disable >= creation; journal must contain PREPARED then optional DISABLED_LOCAL with unchanged identity. No enable, credential creation, OS access, grant or remote revocation is provided. Checksums are not signatures."
}
