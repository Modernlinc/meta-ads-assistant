  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "workspace-page-live-monitor-intent-v1"
          }
        }
      },
      "then": {
        "required": [
          "workspace_scope_sha256",
          "expected_live_video_id"
        ],
        "properties": {
          "page_id": {
            "type": "string"
          },
          "request_budget": {
            "minimum": 4
          },
          "connection": {
            "type": "object",
            "required": [
              "app_id",
              "principal_id",
              "schema",
              "credential_source",
              "credential_reference",
              "app_developer_confirmed",
              "asset_owner_confirmed",
              "appsecret_proof_requirement",
              "page_id"
            ],
            "properties": {
              "app_id": {
                "type": "string",
                "pattern": "^[0-9]{1,40}$"
              },
              "principal_id": {
                "type": "string",
                "pattern": "^[0-9]{1,40}$"
              },
              "schema": {
                "const": "page-connection-intent-v1"
              },
              "credential_source": {
                "enum": [
                  "SESSION_INPUT",
                  "OS_REFERENCE"
                ]
              },
              "credential_reference": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^conn_[0-9a-f]{32}$"
              },
              "app_developer_confirmed": {
                "type": "boolean"
              },
              "asset_owner_confirmed": {
                "type": "boolean"
              },
              "appsecret_proof_requirement": {
                "enum": [
                  "UNKNOWN",
                  "REQUIRED",
                  "NOT_REQUIRED_CONFIRMED"
                ]
              },
              "page_id": {
                "type": "string",
                "pattern": "^[0-9]{1,40}$"
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "required": [
              "page",
              "live"
            ],
            "propertyNames": {
              "enum": [
                "page",
                "live",
                "comments",
                "live_post",
                "live_current_viewers",
                "live_views",
                "live_social_actions",
                "live_views_by_status"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "verify_page_insights_role"
              ],
              "properties": {
                "verify_page_insights_role": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "request_budget": {
                  "minimum": 6
                },
                "sources": {
                  "required": [
                    "live_post",
                    "live_current_viewers",
                    "live_views",
                    "live_social_actions",
                    "live_views_by_status"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "cycles": {
                  "minimum": 2
                }
              }
            },
            "then": {
              "properties": {
                "pages_per_source": {
                  "const": 1
                }
              }
            }
          }
        ]
      },
      "else": {
        "not": {
          "required": [
            "expected_live_video_id"
          ]
        },
        "properties": {
          "verify_page_insights_role": false,
          "connection": {
            "$ref": "connection-intent.schema.json"
          },
          "sources": {
            "required": [
              "account"
            ],
            "properties": {
              "live": {
                "not": {
                  "required": [
                    "expected_live_video_id"
                  ]
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "schema": {
              "const": "workspace-monitor-intent-v1"
            }
          }
        },
        "then": {
          "required": [
            "workspace_scope_sha256"
          ],
          "properties": {
            "page_id": {
              "type": "null"
            },
            "sources": {
              "oneOf": [
                {
                  "required": [
                    "account",
                    "ads"
                  ],
                  "maxProperties": 2
                },
                {
                  "required": [
                    "account",
                    "ad_links",
                    "ads"
                  ],
                  "maxProperties": 3
                },
                {
                  "required": [
                    "account",
                    "ad_inventory",
                    "adsets",
                    "campaigns"
                  ],
                  "maxProperties": 4
                },
                {
                  "required": [
                    "account",
                    "placements"
                  ],
                  "maxProperties": 2
                }
              ]
            }
          }
        },
        "else": {
          "not": {
            "required": [
              "workspace_scope_sha256"
            ]
          }
